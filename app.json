{
  "expo": {
    "name": "GeoSafe",
    "slug": "geosafe",
    "version": "1.0.0",
    "scheme": "geosafe",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.geosafe.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GeoSafe uses your location to analyse seismic risk at your current position."
      }
    },
    "android": {
      "package": "com.geosafe.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GeoSafe needs your location for seismic risk analysis."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0437ea8-c226-4247-88ae-b502a5533c4b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/f0437ea8-c226-4247-88ae-b502a5533c4b"
    }
  }
}
