{
  "expo": {
    "name": "GeoSafe",
    "slug": "geosafe",
    "version": "1.0.0",
    "scheme": "geosafe",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.geosafe.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GeoSafe uses your location to analyse seismic risk at your current position."
      }
    },
    "android": {
      "package": "com.geosafe.app",
      "permissions": ["ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GeoSafe needs your location for seismic risk analysis."
        }
      ],
      "@maplibre/maplibre-react-native"
    ]
  }
}
