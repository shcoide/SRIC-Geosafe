# Copy this file to .env (non-secret defaults) and/or .env.local (secrets —
# see the comments in .env for why they're split) and fill in real values.

# Optional override — leave unset for automatic dev-host detection.
# EXPO_PUBLIC_API_URL=http://<lan-ip-or-host>:8000/api

# Required for OpenCage geocoding (free tier: https://opencagedata.com)
EXPO_PUBLIC_OPENCAGE_KEY=your_opencage_key_here

# Optional — MapTiler's OSM-based raster tiles (free tier: 100,000 map loads/
# month, account required but no billing/credit card). Leave unset to fall
# back to plain OpenStreetMap raster tiles instead, which need no signup at
# all — this is the zero-setup path for offline/CI use. See README ("Coverage
# Map Screen") for both options. This is EXPO_PUBLIC_-prefixed because it's
# read client-side at runtime (a tile URL query param), not a native build
# secret — unlike the Google Maps key this app no longer needs at all now
# that it renders via MapLibre instead of react-native-maps.
EXPO_PUBLIC_MAPTILER_KEY=your_maptiler_key_here
